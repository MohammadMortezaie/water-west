Options -Indexes
DirectoryIndex index.php

RewriteEngine On

# Keep the homepage on one clean URL.
RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
RewriteRule ^index\.php$ / [R=301,L]

# Canonical production host and HTTPS. Local development hosts are left alone.
RewriteCond %{HTTP_HOST} ^www\.waterdamagewestvancouver\.ca$ [NC]
RewriteRule ^ https://waterdamagewestvancouver.ca%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTP_HOST} ^waterdamagewestvancouver\.ca$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://waterdamagewestvancouver.ca%{REQUEST_URI} [R=301,L]

# Remove trailing slashes from clean URLs, except the homepage.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Route clean, extension-free URLs through the PHP front controller.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L,QSA]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    <FilesMatch "\.(?:css|js|svg|png|webp)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

ErrorDocument 404 /index.php
